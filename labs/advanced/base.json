{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "kf-platform",
        "labels": {
          "kubefoundry.io/managed": "advanced",
          "pod-security.kubernetes.io/enforce": "restricted",
          "pod-security.kubernetes.io/enforce-version": "v1.36"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "settings",
        "namespace": "kf-platform"
      },
      "data": {
        "message": "primeira-configuracao"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Secret",
      "metadata": {
        "name": "credentials",
        "namespace": "kf-platform"
      },
      "type": "Opaque",
      "stringData": {
        "token": "SOMENTE-EXEMPLO-SEM-VALOR-REAL"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "workbench",
        "namespace": "kf-platform"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "workbench"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "workbench"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "fsGroup": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "workbench",
                "image": "kubefoundry/workbench:0.1.0",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "128Mi"
                  }
                },
                "ports": [
                  {
                    "containerPort": 8080,
                    "name": "http"
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "settings",
                    "mountPath": "/settings",
                    "readOnly": true
                  },
                  {
                    "name": "credentials",
                    "mountPath": "/credentials",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/data"
                  }
                ],
                "imagePullPolicy": "Never",
                "env": [
                  {
                    "name": "APP_MESSAGE",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "settings",
                        "key": "message"
                      }
                    }
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "periodSeconds": 2
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "periodSeconds": 10
                }
              }
            ],
            "volumes": [
              {
                "name": "settings",
                "configMap": {
                  "name": "settings"
                }
              },
              {
                "name": "credentials",
                "secret": {
                  "secretName": "credentials"
                }
              },
              {
                "name": "data",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "workbench",
        "namespace": "kf-platform"
      },
      "spec": {
        "selector": {
          "app": "workbench"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "storage",
        "namespace": "kf-platform"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "storage"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "storage"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "fsGroup": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "workbench",
                "image": "kubefoundry/workbench:0.1.0",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "128Mi"
                  }
                },
                "ports": [
                  {
                    "containerPort": 8080,
                    "name": "http"
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "settings",
                    "mountPath": "/settings",
                    "readOnly": true
                  },
                  {
                    "name": "credentials",
                    "mountPath": "/credentials",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/data"
                  }
                ],
                "imagePullPolicy": "Never",
                "env": [
                  {
                    "name": "APP_MESSAGE",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "settings",
                        "key": "message"
                      }
                    }
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "periodSeconds": 2
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "periodSeconds": 10
                }
              }
            ],
            "volumes": [
              {
                "name": "settings",
                "configMap": {
                  "name": "settings"
                }
              },
              {
                "name": "credentials",
                "secret": {
                  "secretName": "credentials"
                }
              }
            ]
          }
        },
        "serviceName": "storage",
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "1Gi"
                }
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "storage",
        "namespace": "kf-platform"
      },
      "spec": {
        "selector": {
          "app": "storage"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "namespace-isolation",
        "namespace": "kf-platform"
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Ingress",
          "Egress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {}
              },
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kf-observability"
                  }
                }
              },
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "envoy-gateway-system"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8080
              }
            ]
          }
        ],
        "egress": [
          {
            "to": [
              {
                "podSelector": {}
              }
            ]
          },
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "k8s-app": "kube-dns"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 53,
                "protocol": "UDP"
              },
              {
                "port": 53,
                "protocol": "TCP"
              }
            ]
          },
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kf-observability"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 4318
              }
            ]
          }
        ]
      }
    }
  ]
}
