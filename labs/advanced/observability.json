{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "kf-observability",
        "labels": {
          "kubefoundry.io/managed": "advanced",
          "pod-security.kubernetes.io/enforce": "restricted",
          "pod-security.kubernetes.io/enforce-version": "v1.36"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "jaeger",
        "namespace": "kf-observability"
      },
      "data": {
        "config.json": "{\"extensions\": {\"jaeger_storage\": {\"backends\": {\"memory\": {\"memory\": {\"max_traces\": 5000}}}}, \"jaeger_query\": {\"storage\": {\"traces\": \"memory\"}, \"http\": {\"endpoint\": \"0.0.0.0:16686\"}}}, \"receivers\": {\"otlp\": {\"protocols\": {\"http\": {\"endpoint\": \"0.0.0.0:4318\"}}}}, \"exporters\": {\"jaeger_storage_exporter\": {\"trace_storage\": \"memory\"}}, \"service\": {\"extensions\": [\"jaeger_storage\", \"jaeger_query\"], \"pipelines\": {\"traces\": {\"receivers\": [\"otlp\"], \"exporters\": [\"jaeger_storage_exporter\"]}}}}"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "jaeger",
        "namespace": "kf-observability"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "jaeger"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "jaeger"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "fsGroup": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "jaeger",
                "image": "cr.jaegertracing.io/jaegertracing/jaeger:2.22.0",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "ports": [
                  {
                    "containerPort": 16686,
                    "name": "http"
                  },
                  {
                    "containerPort": 4318,
                    "name": "otlp"
                  }
                ],
                "args": [
                  "--config=/config/config.json"
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/config",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/data"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "jaeger"
                }
              },
              {
                "name": "data",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "jaeger",
        "namespace": "kf-observability"
      },
      "spec": {
        "selector": {
          "app": "jaeger"
        },
        "ports": [
          {
            "name": "http",
            "port": 16686,
            "targetPort": 16686
          },
          {
            "name": "otlp",
            "port": 4318,
            "targetPort": 4318
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "collector",
        "namespace": "kf-observability"
      },
      "data": {
        "config.json": "{\"receivers\": {\"otlp\": {\"protocols\": {\"http\": {\"endpoint\": \"0.0.0.0:4318\"}}}}, \"processors\": {\"memory_limiter\": {\"check_interval\": \"1s\", \"limit_mib\": 96}, \"batch\": {\"timeout\": \"1s\", \"send_batch_size\": 128}}, \"exporters\": {\"otlp_http\": {\"endpoint\": \"http://jaeger:4318\"}, \"debug\": {\"verbosity\": \"basic\"}}, \"service\": {\"pipelines\": {\"traces\": {\"receivers\": [\"otlp\"], \"processors\": [\"memory_limiter\", \"batch\"], \"exporters\": [\"otlp_http\", \"debug\"]}}}}"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "collector",
        "namespace": "kf-observability"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "collector"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "collector"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "fsGroup": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "collector",
                "image": "otel/opentelemetry-collector-contrib:0.162.0",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "ports": [
                  {
                    "containerPort": 4318,
                    "name": "otlp"
                  }
                ],
                "args": [
                  "--config=/config/config.json"
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/config",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/data"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "collector"
                }
              },
              {
                "name": "data",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "collector",
        "namespace": "kf-observability"
      },
      "spec": {
        "selector": {
          "app": "collector"
        },
        "ports": [
          {
            "name": "otlp",
            "port": 4318,
            "targetPort": 4318
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "prometheus",
        "namespace": "kf-observability"
      },
      "data": {
        "config.json": "{\"global\": {\"scrape_interval\": \"5s\", \"evaluation_interval\": \"5s\"}, \"rule_files\": [\"/config/alerts.json\"], \"scrape_configs\": [{\"job_name\": \"workbench\", \"static_configs\": [{\"targets\": [\"workbench.kf-platform.svc:8080\"]}]}]}",
        "alerts.json": "{\"groups\": [{\"name\": \"workbench\", \"rules\": [{\"alert\": \"WorkbenchIntentionalFailure\", \"expr\": \"increase(workbench_failures_total[2m]) > 0\", \"for\": \"0s\", \"labels\": {\"severity\": \"warning\"}, \"annotations\": {\"summary\": \"Falha controlada do laboratorio\"}}]}]}"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "prometheus",
        "namespace": "kf-observability"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "prometheus"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "prometheus"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "fsGroup": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "prometheus",
                "image": "prom/prometheus:v3.15.0",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "ports": [
                  {
                    "containerPort": 9090,
                    "name": "http"
                  }
                ],
                "args": [
                  "--config.file=/config/config.json",
                  "--storage.tsdb.path=/data",
                  "--storage.tsdb.retention.time=1h"
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/config",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/data"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "prometheus"
                }
              },
              {
                "name": "data",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "prometheus",
        "namespace": "kf-observability"
      },
      "spec": {
        "selector": {
          "app": "prometheus"
        },
        "ports": [
          {
            "name": "http",
            "port": 9090,
            "targetPort": 9090
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "telemetry-isolation",
        "namespace": "kf-observability"
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Ingress",
          "Egress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {}
              }
            ]
          },
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kf-platform"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 4318
              }
            ]
          }
        ],
        "egress": [
          {
            "to": [
              {
                "podSelector": {}
              }
            ]
          },
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kf-platform"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8080
              }
            ]
          },
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "k8s-app": "kube-dns"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 53,
                "protocol": "UDP"
              },
              {
                "port": 53,
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    }
  ]
}
